<Window
    x:Class="MugiSideBrowser.WinUI3.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:wv2="using:Microsoft.Web.WebView2.WinUI3"
    xmlns:sizers="using:CommunityToolkit.WinUI.Controls"
    mc:Ignorable="d"
    Title="MugiSideBrowser">

    <Window.Resources>
        <!-- Menu Flyout for Web Page Options -->
        <MenuFlyout x:Key="PageToolsMenu">
            <MenuFlyoutItem Text="ページを更新" Click="Reload_Click">
                <MenuFlyoutItem.Icon>
                    <FontIcon Glyph="&#x200B;&#xE72C;"/>
                </MenuFlyoutItem.Icon>
            </MenuFlyoutItem>
            <MenuFlyoutItem Text="モバイル表示に切り替え" Click="UserAgent_Click" Tag="UserAgent">
                <MenuFlyoutItem.Icon>
                    <FontIcon Glyph="&#xE8EA;"/>
                </MenuFlyoutItem.Icon>
            </MenuFlyoutItem>
            <MenuFlyoutSeparator/>
            <MenuFlyoutItem Text="このページをお気に入りに追加" Click="Star_Click">
                <MenuFlyoutItem.Icon>
                    <FontIcon Glyph="&#xE734;"/>
                </MenuFlyoutItem.Icon>
            </MenuFlyoutItem>
            <MenuFlyoutItem Text="URLをコピー" Click="CopyUrl_Click">
                <MenuFlyoutItem.Icon>
                    <FontIcon Glyph="&#xE8C8;"/>
                </MenuFlyoutItem.Icon>
            </MenuFlyoutItem>
            <MenuFlyoutItem Text="既定のブラウザで開く" Click="OpenExternal_Click">
                <MenuFlyoutItem.Icon>
                    <FontIcon Glyph="&#xE8A7;"/>
                </MenuFlyoutItem.Icon>
            </MenuFlyoutItem>
            <MenuFlyoutSeparator/>
            <MenuFlyoutItem Text="初期ページに戻る" Click="ResetToInitialPage_Click">
                <MenuFlyoutItem.Icon>
                    <FontIcon Glyph="&#xE80F;"/>
                </MenuFlyoutItem.Icon>
            </MenuFlyoutItem>
            <MenuFlyoutItem Text="このペインを閉じる" Click="CloseActivePane_Click">
                <MenuFlyoutItem.Icon>
                    <FontIcon Glyph="&#xE711;"/>
                </MenuFlyoutItem.Icon>
            </MenuFlyoutItem>
        </MenuFlyout>

        <!-- Menu Flyout for Settings -->
        <MenuFlyout x:Key="ToolsMenu">
            <MenuFlyoutItem Text="区切り線を追加" Click="AddSeparator_Click">
                <MenuFlyoutItem.Icon>
                    <FontIcon Glyph="&#xE74F;"/>
                </MenuFlyoutItem.Icon>
            </MenuFlyoutItem>
            <MenuFlyoutSeparator/>
            <MenuFlyoutItem x:Name="ThemeToggleMenuItem" Text="ライトモードに切り替え" Click="ThemeToggle_Click">
                <MenuFlyoutItem.Icon>
                    <FontIcon x:Name="ThemeIcon" Glyph="&#xE706;"/>
                </MenuFlyoutItem.Icon>
            </MenuFlyoutItem>
            <MenuFlyoutSeparator/>
            <MenuFlyoutItem x:Name="SidebarPositionToggleMenuItem" Text="お気に入りを右側に移動" Click="SidebarPositionToggle_Click">
                <MenuFlyoutItem.Icon>
                    <FontIcon x:Name="SidebarPositionIcon" Glyph="&#xE8A4;"/>
                </MenuFlyoutItem.Icon>
            </MenuFlyoutItem>
            <MenuFlyoutSeparator/>
            <ToggleMenuFlyoutItem x:Name="ExternalBrowserMenuItem" Text="新しいウィンドウは既定のブラウザで開く" IsChecked="True" Click="ExternalBrowser_Click">
                <ToggleMenuFlyoutItem.Icon>
                    <FontIcon Glyph="&#xE8A7;"/>
                </ToggleMenuFlyoutItem.Icon>
            </ToggleMenuFlyoutItem>
        </MenuFlyout>

        <!-- Custom Tool Buttons Style (Modern Clean) -->
        <Style x:Key="ToolbarButtonStyle" TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="8,4"/>
            <Setter Property="Margin" Value="4,0"/>
            <Setter Property="FontFamily" Value="Segoe Fluent Icons"/>
            <Setter Property="FontSize" Value="12"/>
        </Style>

        <Style x:Key="SidebarDockButtonStyle" TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Height" Value="40"/>
            <Setter Property="Width" Value="40"/>
            <Setter Property="FontFamily" Value="Segoe Fluent Icons"/>
            <Setter Property="FontSize" Value="16"/>
        </Style>
    </Window.Resources>

    <Grid x:Name="RootGrid" Background="{ThemeResource AppBackground}" FontFamily="Segoe UI Variable Text">
        <Grid.ColumnDefinitions>
            <ColumnDefinition x:Name="LeftResizeColumn" Width="4"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition x:Name="RightResizeColumn" Width="0"/>
        </Grid.ColumnDefinitions>
        
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition x:Name="BottomResizeRow" Height="0"/>
        </Grid.RowDefinitions>

        <!-- Left/Bottom Resize Grips (Managed in WinUI 3 via pointers) -->
        <Border x:Name="LeftResizeGrip" Grid.Column="0" Grid.Row="0" Background="Transparent" Cursor="SizeWestEast" 
                PointerPressed="ResizeGrip_PointerPressed" PointerMoved="ResizeGrip_PointerMoved" PointerReleased="ResizeGrip_PointerReleased"/>
        
        <Border x:Name="BottomResizeGrip" Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="3" Background="Transparent" Cursor="SizeNorthSouth" 
                PointerPressed="ResizeGrip_PointerPressed" PointerMoved="ResizeGrip_PointerMoved" PointerReleased="ResizeGrip_PointerReleased"/>

        <!-- Main Window Container -->
        <Grid Grid.Column="1" x:Name="WindowContainer">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" x:Name="TitleBarRow"/>
                <RowDefinition Height="Auto" x:Name="AddressBarRow"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Custom Title Bar / Drag Area -->
            <Border Grid.Row="0" Background="{ThemeResource TitleBarBackground}" Padding="8,6"
                    PointerPressed="TitleBar_PointerPressed" 
                    PointerMoved="TitleBar_PointerMoved" 
                    PointerReleased="TitleBar_PointerReleased">
                <DockPanel LastChildFill="True">
                    <StackPanel Orientation="Horizontal" DockPanel.Dock="Left" VerticalAlignment="Center">
                        <TextBlock Text="MugiSideBrowser" Foreground="{ThemeResource SecondaryText}" FontSize="12" VerticalAlignment="Center" Margin="4,0,0,0"/>
                    </StackPanel>
                    
                    <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" VerticalAlignment="Center">
                        <Button x:Name="ToggleNormalAppBarButton" Content="&#xE7C9;" Click="ToggleNormalAppBar_Click" Style="{StaticResource ToolbarButtonStyle}"/>
                        <Button x:Name="ToggleAppBarAutoHideButton" Content="&#xE7B3;" Click="ToggleAppBarAutoHide_Click" Style="{StaticResource ToolbarButtonStyle}"/>
                        <Button x:Name="MinimizeButton" Content="&#xE921;" Click="Minimize_Click" Style="{StaticResource ToolbarButtonStyle}"/>
                        <Button Content="&#xE711;" Click="Close_Click" Style="{StaticResource ToolbarButtonStyle}" Foreground="{ThemeResource DangerForeground}"/>
                    </StackPanel>

                    <Grid/>
                </DockPanel>
            </Border>

            <!-- Address Bar & Tools -->
            <Border Grid.Row="1" Background="{ThemeResource AddressBarBackground}" Padding="8,4" BorderBrush="{ThemeResource BorderColor}" BorderThickness="0,1">
                <TextBox x:Name="UrlTextBox" Background="{ThemeResource BorderColor}" Foreground="{ThemeResource PrimaryText}" 
                         BorderThickness="1" BorderBrush="{ThemeResource TextBoxBorderColor}"
                         Padding="8,4" KeyDown="UrlTextBox_KeyDown" FontSize="13" CornerRadius="4"/>
            </Border>

            <!-- Main Layout (Sidebar + Browsers) -->
            <Grid Grid.Row="2" x:Name="MainContentGrid">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" x:Name="SidebarColumn"/>
                    <ColumnDefinition Width="*" x:Name="BrowserColumn"/>
                </Grid.ColumnDefinitions>

                <!-- Vertical Favorites Tab Bar -->
                <Border x:Name="SidebarBorder" Grid.Column="0" Width="48" Background="{ThemeResource TitleBarBackground}" BorderBrush="{ThemeResource BorderColor}" BorderThickness="0,0,1,0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- Add Bookmark Button -->
                        <Button Grid.Row="0" Content="&#xE710;" Style="{StaticResource SidebarDockButtonStyle}" 
                                Click="Star_Click" Margin="4,6"/>

                        <!-- Bookmarks List -->
                        <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Hidden">
                            <ItemsControl x:Name="BookmarkList">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <ItemsStackPanel Orientation="Vertical"/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <!-- Visual Representation will be bound to items -->
                                        <Grid Margin="4,2">
                                            <Border CornerRadius="6" Padding="8" Cursor="Hand" Background="Transparent"
                                                    ContextFlyout="{StaticResource PageToolsMenu}"
                                                    PointerPressed="Bookmark_PointerPressed"
                                                    PointerMoved="Bookmark_PointerMoved"
                                                    PointerReleased="Bookmark_PointerReleased">
                                                <Image Source="{Binding DisplayFaviconUrl}" Width="20" Height="20" Stretch="Uniform"/>
                                            </Border>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>

                        <!-- Tools Button -->
                        <Button Grid.Row="2" Content="&#xE713;" Style="{StaticResource SidebarDockButtonStyle}" 
                                Click="Tools_Click" Flyout="{StaticResource ToolsMenu}" Margin="4,6"/>
                    </Grid>
                </Border>

                <!-- Split Browser Grid -->
                <Grid x:Name="BrowserGroupGrid" Grid.Column="1">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" x:Name="TopRow"/>
                        <RowDefinition Height="Auto" x:Name="SplitterRow1"/>
                        <RowDefinition Height="0" x:Name="MiddleRow"/>
                        <RowDefinition Height="Auto" x:Name="SplitterRow2"/>
                        <RowDefinition Height="0" x:Name="BottomRow"/>
                    </Grid.RowDefinitions>

                    <!-- Top Panel -->
                    <Grid x:Name="WebViewContainer" Grid.Row="0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <Border x:Name="TopHeader" Grid.Row="0" Height="28" Background="{ThemeResource TitleBarBackground}" BorderBrush="{ThemeResource BorderColor}" BorderThickness="0,0,0,1">
                            <DockPanel Margin="8,0">
                                <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" VerticalAlignment="Center">
                                    <Button x:Name="TopBackButton" Content="&#xE72B;" Style="{StaticResource ToolbarButtonStyle}" Click="HeaderBack_Click" Tag="Top"/>
                                    <Button x:Name="TopForwardButton" Content="&#xE72A;" Style="{StaticResource ToolbarButtonStyle}" Click="HeaderForward_Click" Tag="Top"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Ellipse x:Name="TopActiveIndicator" Width="6" Height="6" Fill="{StaticResource TabActiveBar}" Margin="0,0,6,0"/>
                                    <TextBlock x:Name="TopHeaderText" Text="メインペイン" FontSize="11" Foreground="{ThemeResource PrimaryText}" FontWeight="SemiBold"/>
                                </StackPanel>
                            </DockPanel>
                        </Border>
                        <Grid x:Name="WebViewTopHolder" Grid.Row="1"/>
                    </Grid>

                    <!-- Splitter 1 -->
                    <sizers:GridSplitter Grid.Row="1" Height="4" HorizontalAlignment="Stretch" VerticalAlignment="Center" 
                                         Background="{ThemeResource BorderColor}" Visibility="Collapsed" x:Name="RowSplitter1"/>

                    <!-- Middle Panel -->
                    <Grid x:Name="WebViewMiddleContainer" Grid.Row="2" Visibility="Collapsed">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <Border x:Name="MiddleHeader" Grid.Row="0" Height="28" Background="{ThemeResource TitleBarBackground}" BorderBrush="{ThemeResource BorderColor}" BorderThickness="0,0,0,1">
                            <DockPanel Margin="8,0">
                                <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" VerticalAlignment="Center">
                                    <Button x:Name="MiddleBackButton" Content="&#xE72B;" Style="{StaticResource ToolbarButtonStyle}" Click="HeaderBack_Click" Tag="Middle"/>
                                    <Button x:Name="MiddleForwardButton" Content="&#xE72A;" Style="{StaticResource ToolbarButtonStyle}" Click="HeaderForward_Click" Tag="Middle"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Ellipse x:Name="MiddleActiveIndicator" Width="6" Height="6" Fill="{ThemeResource TabInactiveBar}" Margin="0,0,6,0" Visibility="Collapsed"/>
                                    <TextBlock x:Name="MiddleHeaderText" Text="分割ペイン（中央）" FontSize="11" Foreground="{ThemeResource SecondaryText}"/>
                                </StackPanel>
                            </DockPanel>
                        </Border>
                        <Grid x:Name="WebViewMiddleHolder" Grid.Row="1"/>
                    </Grid>

                    <!-- Splitter 2 -->
                    <sizers:GridSplitter Grid.Row="3" Height="4" HorizontalAlignment="Stretch" VerticalAlignment="Center" 
                                         Background="{ThemeResource BorderColor}" Visibility="Collapsed" x:Name="RowSplitter2"/>

                    <!-- Bottom Panel -->
                    <Grid x:Name="WebViewBottomContainer" Grid.Row="4" Visibility="Collapsed">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <Border x:Name="BottomHeader" Grid.Row="0" Height="28" Background="{ThemeResource TitleBarBackground}" BorderBrush="{ThemeResource BorderColor}" BorderThickness="0,0,0,1">
                            <DockPanel Margin="8,0">
                                <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" VerticalAlignment="Center">
                                    <Button x:Name="BottomBackButton" Content="&#xE72B;" Style="{StaticResource ToolbarButtonStyle}" Click="HeaderBack_Click" Tag="Bottom"/>
                                    <Button x:Name="BottomForwardButton" Content="&#xE72A;" Style="{StaticResource ToolbarButtonStyle}" Click="HeaderForward_Click" Tag="Bottom"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Ellipse x:Name="BottomActiveIndicator" Width="6" Height="6" Fill="{ThemeResource TabInactiveBar}" Margin="0,0,6,0" Visibility="Collapsed"/>
                                    <TextBlock x:Name="BottomHeaderText" Text="分割ペイン（下部）" FontSize="11" Foreground="{ThemeResource SecondaryText}"/>
                                </StackPanel>
                            </DockPanel>
                        </Border>
                        <Grid x:Name="WebViewBottomHolder" Grid.Row="1"/>
                    </Grid>
                </Grid>
            </Grid>
        </Grid>
    </Grid>
</Window>
