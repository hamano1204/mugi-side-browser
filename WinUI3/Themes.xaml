<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ResourceDictionary.ThemeDictionaries>
        <!-- Dark Theme (Default in WinUI 3) -->
        <ResourceDictionary x:Key="Default">
            <!-- ベースカラー -->
            <SolidColorBrush x:Key="AppBackground" Color="#1E1E1E"/>
            <SolidColorBrush x:Key="TitleBarBackground" Color="#2D2D2D"/>
            <SolidColorBrush x:Key="AddressBarBackground" Color="#252525"/>
            
            <!-- 枠線カラー -->
            <SolidColorBrush x:Key="BorderColor" Color="#333333"/>
            <SolidColorBrush x:Key="TextBoxBorderColor" Color="#444444"/>
            <SolidColorBrush x:Key="BookmarkSeparator" Color="#666666"/>
            
            <!-- テキストカラー -->
            <SolidColorBrush x:Key="PrimaryText" Color="White"/>
            <SolidColorBrush x:Key="SecondaryText" Color="#CCCCCC"/>
            
            <!-- インタラクティブ要素カラー -->
            <SolidColorBrush x:Key="HoverBackground" Color="#3D3D3D"/>
            <SolidColorBrush x:Key="SelectionBackground" Color="#0078D4"/>
            <SolidColorBrush x:Key="DangerForeground" Color="#FF6B6B"/>
        </ResourceDictionary>

        <!-- Light Theme -->
        <ResourceDictionary x:Key="Light">
            <!-- ベースカラー -->
            <SolidColorBrush x:Key="AppBackground" Color="#F3F3F3"/>
            <SolidColorBrush x:Key="TitleBarBackground" Color="#E5E5E5"/>
            <SolidColorBrush x:Key="AddressBarBackground" Color="#FFFFFF"/>
            
            <!-- 枠線カラー -->
            <SolidColorBrush x:Key="BorderColor" Color="#CCCCCC"/>
            <SolidColorBrush x:Key="TextBoxBorderColor" Color="#BBBBBB"/>
            <SolidColorBrush x:Key="BookmarkSeparator" Color="#9E9E9E"/>
            
            <!-- テキストカラー -->
            <SolidColorBrush x:Key="PrimaryText" Color="#202020"/>
            <SolidColorBrush x:Key="SecondaryText" Color="#5F5F5F"/>
            
            <!-- インタラクティブ要素カラー -->
            <SolidColorBrush x:Key="HoverBackground" Color="#E1E1E1"/>
            <SolidColorBrush x:Key="SelectionBackground" Color="#0078D4"/>
            <SolidColorBrush x:Key="DangerForeground" Color="#E81123"/>
        </ResourceDictionary>
    </ResourceDictionary.ThemeDictionaries>

    <!-- Brand / Accent Colors (Theme-independent) -->
    <SolidColorBrush x:Key="TabActiveBar" Color="#4A90E2" />
    <SolidColorBrush x:Key="TabInactiveBar" Color="#2ECC71" />

</ResourceDictionary>
