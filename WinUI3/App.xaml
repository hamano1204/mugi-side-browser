<Application x:Class="MugiSideBrowser.WinUI3.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:tb="using:H.NotifyIcon">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
                <ResourceDictionary Source="Themes.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <!-- System Tray Icon Resource -->
            <tb:TaskbarIcon
                x:Key="TrayIcon"
                ToolTipText="MugiSideBrowser"
                ForceCreate="True"
                TrayLeftMouseDown="TrayIcon_TrayLeftMouseDown">
                <tb:TaskbarIcon.ContextFlyout>
                    <MenuFlyout>
                        <MenuFlyoutItem Text="サイドバーを開く" Click="TrayOpen_Click"/>
                        <MenuFlyoutSeparator/>
                        <MenuFlyoutItem Text="終了する" Click="TrayExit_Click"/>
                    </MenuFlyout>
                </tb:TaskbarIcon.ContextFlyout>
            </tb:TaskbarIcon>
        </ResourceDictionary>
    </Application.Resources>
</Application>
